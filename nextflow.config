/*
 * ====================================================================
 *  Configuration: tumor-microenvironment-scrna-atlas
 *  Deciphering Tumor Microenvironment Heterogeneity via scRNA-seq
 * ====================================================================
 */

params {
    // Input/Output parameters
    samplesheet         = "${projectDir}/data/samplesheet.csv"
    counts_dir          = "${projectDir}/data/counts"
    genome_index        = "${projectDir}/reference/star_index"
    whitelist_v3        = "${projectDir}/reference/3M-february-2018.txt.gz"
    whitelist_v2        = "${projectDir}/reference/737K-august-2016.txt"
    outdir              = "${projectDir}/results"

    // Workflow execution toggles
    run_upstream        = false
    run_downstream      = true
    help                = false
}

process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = '2.GB'
        time   = '2.h'
    }
    withLabel: 'process_medium' {
        cpus   = 2
        memory = '4.GB'
        time   = '4.h'
    }
    withLabel: 'process_high' {
        cpus   = 4
        memory = '5.GB'
        time   = '8.h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    local {
        process.executor = 'local'
        docker.enabled   = false
    }

    docker {
        process.executor  = 'local'
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        process.executor    = 'local'
        singularity.enabled = true
        singularity.autoMounts = true
    }

    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = 'scrna-batch-queue'
        docker.enabled    = true
        aws.region        = 'us-east-1'
    }
}

// Telemetry Reports
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/trace.txt" }
